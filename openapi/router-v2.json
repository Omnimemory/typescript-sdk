                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "请求参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "query": {
                    "description": "检索查询语句",
                    "title": "Query",
                    "type": "string"
                  },
                  "top_k": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "返回条数上限",
                    "title": "Top K"
                  },
                  "group_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "按归组过滤检索范围，可选（兼容别名 groupId）；缺省时回退用 session_id 缩小范围。",
                    "title": "Group Id"
                  },
                  "client_meta": {
                    "anyOf": [
                      {
                        "description": "数据面请求的客户端元信息。仅 `device_no` 生效；其它字段会被忽略（不消费、不透传到底层），不会报错。",
                        "properties": {
                          "device_no": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "客户自定义设备号；带上则该请求的记忆按设备隔离（亦可用请求头 X-Device-No）。",
                            "title": "Device No"
                          }
                        },
                        "title": "ClientMeta",
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "query"
                ],
                "title": "MemoryRetrievalPayload",
                "type": "object"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Device-No",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "客户自定义设备号；带上则该次 ingest 的记忆按设备隔离。也可放 body 的 client_meta.device_no。"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/memory/ingest/jobs/{job_id}": {
      "get": {
        "tags": [
          "Memory (数据面)"
        ],
        "summary": "ingest 任务状态（信封版）",
        "description": "按 job_id 查单次 ingest 任务当前状态；查无返回 404 job_not_found。数据面接口，鉴权用 API Key（请求头 X-API-Key 或 Authorization: Bearer qbk_...）。带设备号（X-Device-No 或 body.client_meta.device_no）时按设备隔离记忆命名空间。",
        "operationId": "ingest_job_status_memory_ingest_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "ingest 任务ID（提交时返回的 job_id）",
              "title": "Job Id"
            },
            "description": "ingest 任务ID（提交时返回的 job_id）"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_IngestJobStatus_"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "未认证或 token 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "请求参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Envelope_IngestJobAck_": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "ok"
          },
          "code": {
            "type": "integer",
            "title": "Code",
            "description": "与 HTTP 状态码一致（成功时为 200 / 201 / 202）"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestJobAck"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Envelope[IngestJobAck]"
      },
      "ErrorEnvelope": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "default": false
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "code": {
            "type": "integer",
            "title": "Code"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorData"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "message",
          "code"
        ],
        "title": "ErrorEnvelope",
        "description": "失败信封（仅文档用）：data.error 为机器可读的业务错误码。"
      },
      "Envelope_MemoryRetrievalOut_": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "ok"
          },
          "code": {
            "type": "integer",
            "title": "Code",
            "description": "与 HTTP 状态码一致（成功时为 200 / 201 / 202）"
          },
          "data": {
            "anyOf": [
              {
